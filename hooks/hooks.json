{
  "description": "EasyPOS tester kit: chặn nối CSDL trực tiếp / gọi prod / lộ mật khẩu, nạp luật đầu mỗi phiên",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-easypos.js\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-rules.js\"" }
        ]
      }
    ]
  }
}
